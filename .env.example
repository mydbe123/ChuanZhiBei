# ============================================================
# 智学引擎 (ZhiXue Engine) - 环境变量模板
# 用法: 复制本文件为 .env（该文件已被 .gitignore 忽略），填入真实值
# 生产环境也可以直接使用同名系统环境变量覆盖
# ============================================================

# ---- 服务端口 ----
SERVER_PORT=8080

# ---- MySQL ----
DB_URL=jdbc:mysql://localhost:3306/zhixue?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true
DB_USERNAME=root
DB_PASSWORD=

# ---- DeepSeek 大模型 ----
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# 支持文本+图像的多模态模型（用于 AI 导师主对话与图片解题）
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash
# 纯文本推理模型（用于结构化输出：出题、学习计划）
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro

# ---- JWT ----
# 至少 32 个字符，生产环境务必替换
JWT_SECRET=change-me-to-a-long-random-secret-key-at-least-32-chars
